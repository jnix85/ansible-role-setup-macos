# Brewfile generated by Ansible role setup_macos
# Do not edit directly; modify Ansible variables instead.

# Taps
{% for tap in setup_macos_brew_taps %}
tap "{{ tap }}"
{% endfor %}

# Formulae
{% for package in setup_macos_brew_packages %}
brew "{{ package }}"
{% endfor %}

# Casks
{% for cask in setup_macos_brew_casks %}
cask "{{ cask }}"
{% endfor %}

# Mac App Store (optional)
{% for app in setup_macos_mas_apps %}
mas "{{ app.name }}", id: {{ app.id }}
{% endfor %}

